# atw-snoop: the ATW800/2 in the Mega STE or TT as a second screen for debugging (src/atwsnoop.h).
#   make         build/ATWSNOOP.TOS, the demo (needs m68k-atari-mint-gcc on the PATH)
#   make test    the card's T425 program in the emulator (Python 3)
#   make e2e     the demo end to end without hardware: 68000 under unicorn, T425 in the emulator (unicorn, Pillow)
# src/snoopprog.h (the T425 program as C arrays) is generated by t425/build_snoop.py and kept in the repository,
# so a program that only uses the library needs no Python.
CC = m68k-atari-mint-gcc
CFLAGS = -mshort -m68000 -O2 -fomit-frame-pointer -ffreestanding -Wall -Wno-main
B = build
ID := $(shell sh -c 'c=$$(git rev-parse --short=7 HEAD 2>/dev/null || echo none); [ -n "$$(git status --porcelain 2>/dev/null)" ] && c=$$c.dirty; echo $$(cat VERSION)+$$c')
PY ?= python3

all: $(B)/ATWSNOOP.TOS
src/snoopprog.h: t425/build_snoop.py t425/t425base.py t425/tasm.py fonts/ter-u16n.bdf
	$(PY) t425/build_snoop.py
$(B)/atwsnoop.o: src/atwsnoop.c src/atwsnoop.h src/snoopprog.h
	@mkdir -p $(B)
	$(CC) $(CFLAGS) -c -o $@ $<
$(B)/snoopdemo.o: demo/snoopdemo.c src/atwsnoop.h FORCE
	@mkdir -p $(B)
	$(CC) $(CFLAGS) -Isrc -DVERSION='"$(ID)"' -c -o $@ $<
$(B)/crt0.o: demo/crt0.S
	@mkdir -p $(B)
	$(CC) -m68000 -c -o $@ $<
$(B)/ATWSNOOP.TOS: $(B)/crt0.o $(B)/atwsnoop.o $(B)/snoopdemo.o
	$(CC) -mshort -m68000 -nostdlib -nostartfiles -s -o $@ $^ -lgcc
	@[ $$(( $$(wc -c < $@) % 2 )) -eq 0 ] || printf '\0' >> $@
	@ls -l $@
test:
	$(PY) tests/test_snoop.py
e2e: $(B)/ATWSNOOP.TOS
	$(PY) tests/test_e2e.py
FORCE:
clean:
	rm -rf $(B)
.PHONY: all test e2e clean FORCE
